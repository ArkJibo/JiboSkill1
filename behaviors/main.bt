    "d28c1b4c-ba12-4196-8948-d92727e723a3": {
        "id": "d28c1b4c-ba12-4196-8948-d92727e723a3",
        "class": "TextToSpeechJs",
        "name": "",
        "options": {
            "getWords": [
                "(callback) => {",
                "  var Q = require('q');",
                "  var testClient = require('../listeners/test-client');",
                "  var test_Client = new testClient();",
                "  ",
                "  test_Client.runTest(notepad.asrResult, notepad.speakerIds);",
                "  ",
                "  test_Client.getTestName().done(",
                "    function(name){",
                "      notepad.statusObj = name;",
                "      notepad.testClient = test_Client;",
                "      console.log(\"status: \", name[\"status\"]);",
                "      callback(name[\"msg\"]);",
                "      ",
                "    }",
                "  );",
                "  ",
                "}"
            ],
            "onWord": [
                "(word) => {",
                "}"
            ]
        },
