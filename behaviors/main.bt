        "id": "1db74c5d-73f4-441e-89aa-c0e119c00441",
        "class": "TextToSpeechJs",
        "name": "",
        "options": {
            "getWords": [
                "(callback) => {",
                "    callback('Staring tests...');",
                "    var Q = require('q');",
                "    var testClient = require('../listeners/test-client');",
                "    var test_Client = new testClient();",
                "    ",
                "    test_Client._runTest(notepad.asrResult, notepad.speakerIds);",
                "    ",
                "    //wait until test finishes",
                "    test_Client._getTestResult().done(",
                "      function(testResult){",
                "        notepad.testRes = testResult;",
                "        emitter.emit('testFinished');",
                "      }",
                "    );",
                "}"
            ],
            "onWord": [
                "(word) => {",
                "}"
            ]
        },
