    "d9792ffb-ed4b-4cf0-8067-9fb72a7b0f4c": {
        "id": "d9792ffb-ed4b-4cf0-8067-9fb72a7b0f4c",
        "class": "TextToSpeechJs",
        "name": "",
        "options": {
            "getWords": [
                "(callback) => {",
                "  var resultObj = notepad.testRes;",
                "  ",
                "  var counter = notepad.counter;",
                "  var result = \"\";",
                "  if (resultObj[counter][\"passed\"] == true){ //test passed",
                "    result += ('Test Name: \"' + resultObj[counter][\"title\"] + '\" Passed\\t'); ",
                "    notepad.passCount += 1;",
                "  }",
                "  else{ //test failed",
                "    result += ('Test Name: \"' + resultObj[counter][\"title\"] + '\" Failed with \"' + resultObj[counter][\"error\"] + '\"');",
                "    notepad.failCount += 1;",
                "  }",
                "  notepad.counter += 1;",
                "  callback(result);",
                "}"
            ],
            "onWord": [
                "(word) => {",
                "}"
            ]
        },
        "asset-pack": "core",
        "parent": 1,
        "decorators": [
            "80b5ef82-7ddd-49a0-b011-835f2fd752a0"
        ]
    },
    "80b5ef82-7ddd-49a0-b011-835f2fd752a0": {
        "id": "80b5ef82-7ddd-49a0-b011-835f2fd752a0",
        "class": "WhileCondition",
        "name": "",
        "options": {
            "init": [
                "() => {",
                "  ",
                "}"
            ],
            "conditional": [
                "() => {",
                "  if (notepad.counter < notepad.loopSize) {",
                "    ",
                "    return true;",
                "  }",
                "  return false;",
                "}"
            ]
        },
        "asset-pack": "core"
    },
    "64647a0f-9878-4985-a5d7-19ff19914650": {
